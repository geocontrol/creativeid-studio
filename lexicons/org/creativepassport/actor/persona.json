{
  "lexicon": 1,
  "id": "org.creativepassport.actor.persona",
  "defs": {
    "main": {
      "type": "record",
      "description": "A creator's public Creative Passport persona record.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["name", "biography", "updatedAt"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 640,
            "maxGraphemes": 64,
            "description": "Display name of the creative persona."
          },
          "biography": {
            "type": "string",
            "maxLength": 10000,
            "maxGraphemes": 1000,
            "description": "Creative statement or biography."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "ISO 8601 timestamp when the persona was last updated locally."
          }
        }
      }
    }
  }
}
